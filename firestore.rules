rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Function to check if user owns the document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /accounts/{accountId} {
      // Allow read/write if the user is admin, or if the user is the owner (checking the owner_uid field)
      allow read, write: if isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid);
      // Allow create if admin, or if the user is creating for themselves
      allow create: if isAdmin() || (request.auth != null && request.resource.data.owner_uid == request.auth.uid);
      
      match /trades/{tradeId} {
        allow read, write: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/accounts/$(accountId)).data.owner_uid == request.auth.uid);
      }
    }
    
    match /account_snapshots/{snapshotId} {
      allow read, write: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/accounts/$(resource.data.account_id)).data.owner_uid == request.auth.uid);
    }
    
    match /funded_account_rules/{ruleId} {
      allow read: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/accounts/$(resource.data.account_id)).data.owner_uid == request.auth.uid);
      allow write: if isAdmin();
    }
    
    match /strategies/{strategyId} {
      allow read: if (resource != null && resource.data.is_public == true) || isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid);
      allow create: if isAdmin() || (request.auth != null && request.resource.data.owner_uid == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.owner_uid == request.auth.uid);
    }
  }
}
